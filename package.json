{
  "name": "ainfo-v14-production",
  "private": true,
  "version": "14.11.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ainfo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ainfo-db --remote",
    "db:backup": "wrangler d1 export ainfo-db --remote --output=backup.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
